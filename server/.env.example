# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/astrowatch
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/astrowatch
MONGO_URI=mongodb://127.0.0.1:27017/astrowatch

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# OpenWeather API (https://openweathermap.org/api)
# Leave blank to fall back to demo weather data
OPENWEATHER_API_KEY=your_api_key_here
WEATHER_CITY=Chennai

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
